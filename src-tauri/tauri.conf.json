{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchouli Helper",
  "version": "0.1.0",
  "identifier": "com.colin.patchoulihelper",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Patchouli Helper — 帕秋莉手册可视化编辑器",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Patchouli book visual editor",
    "longDescription": "Visually build Patchouli guide books (book.json, categories, entries, pages) for Minecraft Forge 1.20.1 and NeoForge 1.21.1, then export a resource pack or write straight into your mod's assets folder.",
    "copyright": "",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
